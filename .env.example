# FHIR R4 base URL, including the /fhir path.
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir

# Transport: stdio (default, no OAuth) or http (OAuth always required).
# Left unset here so `npm start` stays stdio; `npm run start:http`, the
# Docker image and compose.yaml select http themselves.
# MCP_TRANSPORT=http
# PORT=3000

# ── OAuth (required for MCP_TRANSPORT=http) ──────────────────────────────────
# The URL clients use to reach /mcp; the OAuth resource identifier and the
# required token audience. For Docker on your machine, match the published port.
MCP_PUBLIC_URL=http://localhost:3000/mcp
# Issuer exactly as it appears in the token's iss claim (AIC includes :443).
OAUTH_ISSUER=https://your-tenant.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha
# Space-separated scopes every token must carry.
OAUTH_REQUIRED_SCOPES=fhir-mcp:read
# How MCP clients identify themselves to the authorization server, and which
# clients' tokens this server accepts (see docs/cimd-plan.md):
#   public  pre-registered client IDs (e.g. fhir-mcp-public). If the list is
#           empty, any client of the issuer is accepted (startup warning).
#   cimd    client IDs are HTTPS URLs of Client ID Metadata Documents, which
#           must match a pattern: an exact URL, or a prefix ending in /*.
OAUTH_CLIENT_MODE=public
OAUTH_ALLOWED_CLIENT_IDS=fhir-mcp-public
# OAUTH_CLIENT_MODE=cimd
# OAUTH_CIMD_CLIENT_ID_PATTERNS=https://your-cimd-host.example.com/clients/*
# Optional overrides:
# OAUTH_AUDIENCE=
# OAUTH_JWKS_URI=
# OAUTH_ALGORITHMS=RS256,ES256
# OAUTH_CLOCK_SKEW_SECONDS=30

# ── Patient scoping (HTTP only) ──────────────────────────────────────────────
# On by default: every token must carry the caller's FHIR Patient id in
# OAUTH_PATIENT_CLAIM, and each caller can reach only that patient's data.
# Needed whenever FHIR is called with a system-level token. Turning it off
# lets any signed-in user read every patient.
# MCP_PATIENT_SCOPED=true
# OAUTH_PATIENT_CLAIM=patient

# ── Tools and sessions ───────────────────────────────────────────────────────
MCP_READ_ONLY=true
# Browser origins allowed to call /mcp, comma-separated (e.g. MCP Inspector's
# direct mode). Leave unset for CLI and desktop clients.
# MCP_ALLOWED_ORIGINS=http://localhost:6274
# MCP_SESSION_IDLE_MINUTES=30
# MCP_MAX_SESSIONS=100

# ── Outbound calls to FHIR ───────────────────────────────────────────────────
# none: no Authorization header. client_credentials: the server gets its own
# token with an OAuth client_credentials grant (then FHIR_TOKEN_URL,
# FHIR_CLIENT_ID and FHIR_CLIENT_SECRET are required). This is the server's
# identity, not the MCP caller's; the caller's token is never sent to FHIR.
FHIR_AUTH=none
# Token endpoint. AIC: <OAUTH_ISSUER without :443>/access_token, e.g.
# https://your-tenant.forgeblocks.com/am/oauth2/realms/root/realms/alpha/access_token
# FHIR_TOKEN_URL=
# FHIR_CLIENT_ID=
# FHIR_CLIENT_SECRET=
# Space-separated scopes to request (omitted if unset).
# FHIR_SCOPE=
# client_secret_basic (default) or client_secret_post; must match the client's
# token endpoint auth method in the authorization server.
# FHIR_TOKEN_AUTH_METHOD=client_secret_basic
