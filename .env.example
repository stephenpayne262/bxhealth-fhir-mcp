# FHIR R4 base URL, including the /fhir path.
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir

# Transport: stdio (default, no OAuth) or http (OAuth always required).
# Left unset here so `npm start` stays stdio; `npm run start:http` and the
# Docker image select http themselves.
# MCP_TRANSPORT=http
# PORT=3000

# ── OAuth (required for MCP_TRANSPORT=http) ──────────────────────────────────
# The URL clients use to reach /mcp; the OAuth resource identifier and the
# required token audience. For Docker on your machine, match the published port.
MCP_PUBLIC_URL=http://localhost:3000/mcp
# Issuer exactly as it appears in the token's iss claim (AIC includes :443).
OAUTH_ISSUER=https://your-tenant.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha
# Space-separated scopes every token must carry.
OAUTH_REQUIRED_SCOPES=fhir-mcp:read
# Optional overrides:
# OAUTH_AUDIENCE=
# OAUTH_JWKS_URI=
# OAUTH_ALGORITHMS=RS256,ES256
# OAUTH_CLOCK_SKEW_SECONDS=30

# ── Tools and sessions ───────────────────────────────────────────────────────
MCP_READ_ONLY=true
# Browser origins allowed to call /mcp, comma-separated (e.g. MCP Inspector's
# direct mode). Leave unset for CLI and desktop clients.
# MCP_ALLOWED_ORIGINS=http://localhost:6274
# MCP_SESSION_IDLE_MINUTES=30
# MCP_MAX_SESSIONS=100

# ── Outbound calls to FHIR ───────────────────────────────────────────────────
# none: no Authorization header. client_credentials: the server's own PingOne
# token (then the three PINGONE_* values are required).
FHIR_AUTH=none
# PINGONE_ENV_ID=
# PINGONE_CLIENT_ID=
# PINGONE_CLIENT_SECRET=
