# Copy to infra/k8s/.env.k8s (gitignored), then fill in tenant-specific values.
MCP_PUBLIC_URL=https://bxhealth-fhir-mcp.ping-devops.com/mcp
OAUTH_ISSUER=https://your-tenant.forgeblocks.com:443/am/oauth2/realms/root/realms/alpha
OAUTH_REQUIRED_SCOPES=fhir-mcp:read
OAUTH_CLIENT_MODE=cimd
OAUTH_CIMD_CLIENT_ID_PATTERNS=https://bxhealth-fhir-mcp.ping-devops.com/cimd/*,https://chatgpt.com/oauth/*
# Do not set OAUTH_ALLOWED_CLIENT_IDS in CIMD mode.
# Omit OAUTH_AUDIENCE so it defaults to MCP_PUBLIC_URL.
MCP_READ_ONLY=true
MCP_PATIENT_SCOPED=true
OAUTH_PATIENT_CLAIM=patient
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir-agent
FHIR_AUTH=client_credentials
FHIR_TOKEN_URL=https://your-tenant.forgeblocks.com/am/oauth2/realms/root/realms/alpha/access_token
FHIR_CLIENT_ID=replace-with-fhir-system-client-id
FHIR_CLIENT_SECRET=replace-with-fhir-system-client-secret
# FHIR_SCOPE=replace-with-required-system-read-scope
FHIR_TOKEN_AUTH_METHOD=client_secret_basic
# Only needed for browser clients that call /mcp directly. Preserve local
# Inspector origins if you continue to run Inspector on your machine.
# MCP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274
